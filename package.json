{
  "name": "agent-plus",
  "displayName": "Agent Plus",
  "description": "Work plan sidebar, Conversations panel and Answer view shared by Claude Code Plus and Codex Plus.",
  "version": "1.1.0",
  "publisher": "xnervwang",
  "license": "BSD-3-Clause",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xnervwang/vscode-agent-plus"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "work-plan",
    "plan",
    "conversations",
    "claude-code",
    "codex"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the views are read only: answers are not sent and nothing is written to disk."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "agentPlus": {
    "protocol": 1,
    "accepts": [
      1
    ],
    "planFormat": 1,
    "answerFormat": 1
  },
  "contributes": {
    "commands": [
      {
        "command": "agentPlus.refreshWorkPlan",
        "title": "Agent Plus: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentPlus.openWorkPlanFile",
        "title": "Agent Plus: Open the Work Plan File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentPlus.showConversations",
        "title": "Agent Plus: Show Conversations",
        "icon": "$(list-tree)"
      },
      {
        "command": "agentPlus.showStatus",
        "title": "Agent Plus: Show Status"
      },
      {
        "command": "agentPlus.restoreWebviewRequestLimit",
        "title": "Agent Plus: Put Back VS Code's Request Limit"
      },
      {
        "command": "agentPlus.chooseTokenMode",
        "title": "Agent Plus: Choose the Token Mode"
      },
      {
        "command": "agentPlus.showWorkPlanDetail",
        "title": "Agent Plus: Show a Row of the Work Plan"
      },
      {
        "command": "agentPlus.answerQuestion",
        "title": "Agent Plus: Answer a Question"
      },
      {
        "command": "agentPlus.openConversation",
        "title": "Agent Plus: Go to a Conversation"
      },
      {
        "command": "agentPlus.showBrief",
        "title": "Agent Plus: Show Where a Conversation Stands"
      },
      {
        "command": "agentPlus.goToConversation",
        "title": "Agent Plus: Go to the Conversation",
        "icon": "$(arrow-right)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentPlus",
          "title": "Agent Plus",
          "icon": "images/sidebar.svg"
        }
      ],
      "panel": [
        {
          "id": "agentPlusPanel",
          "title": "Conversations",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "agentPlus": [
        {
          "id": "agentPlus.workPlan",
          "name": "Work plan",
          "when": "!agentPlus.alone && config.agentPlus.workPlanView"
        }
      ],
      "agentPlusPanel": [
        {
          "id": "agentPlus.conversations",
          "name": "Conversations",
          "when": "!agentPlus.alone && config.agentPlus.conversationsView"
        },
        {
          "type": "webview",
          "id": "agentPlus.answer",
          "name": "Answer",
          "when": "!agentPlus.alone && config.agentPlus.conversationsView"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentPlus.workPlan",
        "contents": "No work plan for the conversation in front."
      },
      {
        "view": "agentPlus.conversations",
        "contents": "No conversation of this workspace is running or has open rows."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentPlus.showConversations",
          "when": "view == agentPlus.workPlan",
          "group": "navigation@0"
        },
        {
          "command": "agentPlus.openWorkPlanFile",
          "when": "view == agentPlus.workPlan",
          "group": "navigation@1"
        },
        {
          "command": "agentPlus.refreshWorkPlan",
          "when": "view == agentPlus.workPlan",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentPlus.openWorkPlanFile",
          "when": "view == agentPlus.workPlan && viewItem == agentPlusNode",
          "group": "navigation"
        },
        {
          "command": "agentPlus.goToConversation",
          "when": "view == agentPlus.conversations && viewItem == agentPlusConversation",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "agentPlus.refreshWorkPlan",
          "when": "!agentPlus.alone"
        },
        {
          "command": "agentPlus.openWorkPlanFile",
          "when": "!agentPlus.alone"
        },
        {
          "command": "agentPlus.showConversations",
          "when": "!agentPlus.alone"
        },
        {
          "command": "agentPlus.chooseTokenMode",
          "when": "!agentPlus.alone"
        },
        {
          "command": "agentPlus.showWorkPlanDetail",
          "when": "false"
        },
        {
          "command": "agentPlus.answerQuestion",
          "when": "false"
        },
        {
          "command": "agentPlus.openConversation",
          "when": "false"
        },
        {
          "command": "agentPlus.showBrief",
          "when": "false"
        },
        {
          "command": "agentPlus.goToConversation",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Plus",
      "properties": {
        "agentPlus.tokenMode": {
          "type": "string",
          "scope": "application",
          "enum": [
            "interface",
            "essential",
            "all",
            "custom"
          ],
          "enumItemLabels": [
            "Interface features",
            "Essential features",
            "All features",
            "Custom"
          ],
          "enumDescriptions": [
            "Adds nothing to the agent's context, and unloads the work plan plugin.",
            "Adds the work plan and the time-zone note, nothing else.",
            "Adds every feature, including the brief, skill suggestions and wake-ups.",
            "Each feature follows its own setting; all are on until you turn one off."
          ],
          "default": "all",
          "markdownDescription": "Choose which Claude Code Plus and Codex Plus features may add text to the agent's context, which costs tokens. Outside Custom, each feature's own setting has no effect. [What it costs in tokens](https://github.com/xnervwang/vscode-agent-plus#what-it-costs-in-tokens)"
        },
        "agentPlus.workPlanView": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the **Work plan** view: the plan of the conversation in front."
        },
        "agentPlus.conversationsView": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the **Conversations** and **Answer** views in the panel, and the Conversations entry in the status bar."
        },
        "agentPlus.webviewRequestLimit": {
          "type": "string",
          "scope": "application",
          "enum": [
            "ask",
            "raise",
            "leave"
          ],
          "enumDescriptions": [
            "Ask once per VS Code version",
            "Raise it without asking, again after each update. On Linux it still asks",
            "Do not change it"
          ],
          "default": "ask",
          "markdownDescription": "VS Code's limit on requests in flight for all webview tabs together (32). Raising it to 1000000 edits VS Code's `service-worker.js`. Takes effect after VS Code is restarted; VS Code updates reset it. `Agent Plus: Put Back VS Code's Request Limit` returns it to 32."
        }
      }
    }
  }
}
